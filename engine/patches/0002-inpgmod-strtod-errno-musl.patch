--- a/src/spicelib/parser/inpgmod.c	2026-11-09 19:51:28.495300257 +0000
+++ b/src/spicelib/parser/inpgmod.c	2026-11-09 19:51:28.523719789 +0000
@@ -180,7 +180,10 @@
                 errno = 0;    /* To distinguish success/failure after call */
                 dval = strtod(parm, &endptr);
                 /* Check for various possible errors */
-                if ((errno == ERANGE && dval == HUGE_VAL) || errno != 0) {
+                /* musl (Emscripten) sets errno = EINVAL when nothing is converted;
+                   glibc leaves it 0. Only a real conversion can be an error here,
+                   so an unknown parameter name is ignored on both, as on Linux. */
+                if (endptr != parm && ((errno == ERANGE && dval == HUGE_VAL) || errno != 0)) {
                     perror("strtod");
                     controlled_exit(EXIT_FAILURE);
                 }
