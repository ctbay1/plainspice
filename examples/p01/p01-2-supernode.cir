*@ ground 11 16 0
*@ wire 0,9 0,0 9,0
*@ wire 13,0 21,0 21,9
*@ wire 0,6 3,6
*@ wire 7,6 14,6
*@ wire 11,6 11,9
*@ wire 18,6 21,6
