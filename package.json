{
  "name": "plainspice",
  "version": "0.1.0",
  "private": true,
  "description": "A beginner-first, accessible circuit simulator in the browser: real ngspice in WebAssembly, every netlist line explained in plain words.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:golden": "vitest run --project golden",
    "test:e2e": "playwright test",
    "record:native": "node --experimental-strip-types scripts/record-native.ts",
    "engine:build": "bash engine/build.sh",
    "fixture-report": "node --experimental-strip-types scripts/fixture-report.ts",
    "make-link": "node --experimental-strip-types scripts/make-link.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@react-aria/optimize-locales-plugin": "^2.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "uplot": "1.6.32"
  }
}
